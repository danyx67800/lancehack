diff --git a/pexpert/pexpert/arm64/LANCELOT.h b/pexpert/pexpert/arm64/LANCELOT.h
new file mode 100644
index 0000000..e289b48
--- /dev/null
+++ b/pexpert/pexpert/arm64/LANCELOT.h
@@ -0,0 +1,70 @@
+/*
+ * Board config for the Xiaomi Redmi 9 ("lancelot", MediaTek MT6769V/CU,
+ * Helio G80): Cortex-A75 + Cortex-A55, ARMv8.2, no pointer authentication.
+ *
+ * Generic ARM like BCM2837 - none of Apple's implementation-defined system
+ * registers exist here - with 16K pages and GICv3 like VMAPPLE. The GIC has
+ * two security states: ATF/TEE owns Group 0, so everything we own, the timer
+ * included, arrives as a Group 1 IRQ through sleh_irq().
+ *
+ * Values measured on the phone (docs/lancelot-hardware.md): GICv3 dist at
+ * 0x0c000000, redistributor at 0x0c040000, CNTFRQ_EL0 = 13 MHz. MTK uses the
+ * architected timer PPI 27 for the virtual timer.
+ */
+
+#ifndef _PEXPERT_ARM64_LANCELOT_H
+#define _PEXPERT_ARM64_LANCELOT_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define LANCELOT                  1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/* Architected virtual timer PPI (INTID 16 + 11), the GICv3 standard one. */
+#define LANCELOT_VTIMER_INTID     27
+#define BOARD_VTIMER_INTID        LANCELOT_VTIMER_INTID
+#define BOARD_IPI_SGI             1
+
+#define GIC_SPURIOUS_IRQ          1023
+#define GICR_PE_SIZE              0x20000
+
+/* GICv3 register definitions; see the GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+#define ICC_SRE_SRE                             0x1
+
+#endif /* ! _PEXPERT_ARM64_LANCELOT_H */

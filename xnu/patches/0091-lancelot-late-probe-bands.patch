diff --git a/pexpert/pexpert/arm64/LANCELOT.h b/pexpert/pexpert/arm64/LANCELOT.h
--- a/pexpert/pexpert/arm64/LANCELOT.h
+++ b/pexpert/pexpert/arm64/LANCELOT.h
@@ -75,6 +75,17 @@
 /* First row the bootstrap text console owns: just under the stage-0 band. */
 #define BOARD_FB_EARLY_YTOP       (BOARD_FB_YTOP + 56)
 
+/*
+ * Rows pe_serial's framebuffer console owns, and the first row below them. The
+ * console clears its rows in 32-px cells and clears each one again every time
+ * it wraps around, so a probe tile drawn on any of them is erased within a
+ * screenful of output - a panic dump is several. The 28 rows left at the bottom
+ * of the panel are the one place on it that no console activity can reach, and
+ * they are what sweet_probe_band uses for its durable copy of a tile.
+ */
+#define BOARD_FB_CONSOLE_ROWS     ((BOARD_FB_HEIGHT - BOARD_FB_YTOP) / 32)
+#define BOARD_FB_PROBE_YTOP       (BOARD_FB_YTOP + BOARD_FB_CONSOLE_ROWS * 32)
+
 /* 2x Cortex-A75 + 6x Cortex-A55. cpus=1 by default, see machine_routines.c. */
 #define LANCELOT_SMP_MAX_CPUS     8
 #define BOARD_SMP_MAX_CPUS        LANCELOT_SMP_MAX_CPUS

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -95,7 +95,11 @@ sweet_early_string(const char *s)
 void
 sweet_early_band(unsigned int slot, uint32_t colour)
 {
-	volatile uint32_t *base = EARLY_FB + EARLY_YTOP * EARLY_STRIDE + EARLY_XOFF + slot * 64;
+	/* The stage row, not the console's first row: the console owns every row
+	 * from EARLY_YTOP down and clears each one as it scrolls, so a band drawn
+	 * there is erased within a screenful of text. BOARD_FB_YTOP is the row
+	 * start.s paints its own bands on, and nothing else writes to it. */
+	volatile uint32_t *base = EARLY_FB + BOARD_FB_YTOP * EARLY_STRIDE + EARLY_XOFF + slot * 64;
 
 	if (early_disabled || slot > 11) {
 		return;
@@ -108,6 +112,28 @@ sweet_early_band(unsigned int slot, uint32_t colour)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+/*
+ * A tile that outlives the bootstrap console, for probing code that runs long
+ * after it: the same 64x32 slot on the stage row as sweet_early_band, but not
+ * gated on early_disabled (arm_vm_init sets that long before any of this code
+ * runs) and not on a stage number. Slots 0..4 belong to start.s.
+ */
+void
+sweet_probe_band(unsigned int slot, uint32_t colour)
+{
+	volatile uint32_t *base = EARLY_FB + BOARD_FB_YTOP * EARLY_STRIDE + EARLY_XOFF + slot * 64;
+
+	if (early_fb == NULL || slot > 11) {
+		return;
+	}
+	for (unsigned int y = 0; y < 32; y++) {
+		for (unsigned int x = 0; x < 64; x++) {
+			base[y * EARLY_STRIDE + x] = colour;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -11,6 +11,9 @@ void sweet_early_mark(unsigned int stage, const char *label);
 /* A bare 64x32 colour slot on the stage row, for C code that runs before the
  * text console is trusted. Slot 0 is the band start.s draws white. */
 void sweet_early_band(unsigned int slot, uint32_t colour);
+/* The same slot, painted whatever early_disabled says: the only way to see how
+ * far a late startup function got. */
+void sweet_probe_band(unsigned int slot, uint32_t colour);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
@@ -21,6 +24,11 @@ static inline void sweet_early_mark(unsigned int stage, const char *label)
 	(void)stage;
 	(void)label;
 }
+static inline void sweet_probe_band(unsigned int slot, uint32_t colour)
+{
+	(void)slot;
+	(void)colour;
+}
 static inline void sweet_early_disable(void) {}
 #endif
 

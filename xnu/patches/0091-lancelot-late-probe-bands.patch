+/*
+ * Sweet's console owns the whole panel, so the durable copy of a probe tile has
+ * nowhere below it to go and shares the console's first row (see LANCELOT.h,
+ * whose panel has a free strip under the console).
+ */
+#define BOARD_FB_PROBE_YTOP       BOARD_FB_YTOP
 

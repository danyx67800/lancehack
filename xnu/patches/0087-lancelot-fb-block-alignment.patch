diff --git a/pexpert/pexpert/arm64/LANCELOT.h b/pexpert/pexpert/arm64/LANCELOT.h
--- a/pexpert/pexpert/arm64/LANCELOT.h
+++ b/pexpert/pexpert/arm64/LANCELOT.h
@@ -59,8 +59,12 @@
 #define BOARD_FB_XOFF             256
 #define BOARD_FB_YTOP             520
 
-/* The 32MB block the framebuffer lives in: start.s maps it whole, Normal-NC. */
-#define BOARD_EARLY_FB_BLOCK      0x7e400000
+/*
+ * The 32MB block the framebuffer lives in: start.s maps it whole, Normal-NC,
+ * with one L2 block descriptor, whose output address must be 32MB-aligned.
+ * 0x7e605000 & ~(32MB - 1) = 0x7e000000 (TEST #13: 0x7e400000 does not work).
+ */
+#define BOARD_EARLY_FB_BLOCK      0x7e000000
 #define BOARD_EARLY_FB_OFFSET     (BOARD_FB_BASE - BOARD_EARLY_FB_BLOCK)
 
 /*
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -839,6 +839,29 @@
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET) || defined(LANCELOT)
+	/*
+	 * Stage 0b: blue 64x32 band right of the white one, the first store made
+	 * through the MMU. White without blue means the kernel died turning the
+	 * translation on, or the bootstrap mapping of the framebuffer block is
+	 * wrong; either way nothing later can be blamed yet.
+	 */
+	MOV64	x0, BOARD_FB_STAGE0_ADDR
+	add		x0, x0, #256				// 64 pixels right of the white band
+	MOV64	x1, 0xff0000ff				// opaque blue
+	mov		x2, #32
+	MOV64	x4, BOARD_FB_STRIDE
+1:	mov		x3, #64
+	mov		x5, x0
+2:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb		sy
+#endif
+
 #if !VMAPPLE && !defined(SWEET) && !defined(LANCELOT)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1

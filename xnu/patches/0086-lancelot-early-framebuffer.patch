diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -54,6 +54,27 @@
 /* Device-tree node the framebuffer console binds (pexpert/arm/pe_serial.c). */
 #define BOARD_FBCON_NODE          "sweet-fbcon"
 
+/*
+ * Boot framebuffer the bootstrap console draws on before pe_serial's fbcon is
+ * up (osfmk/arm64/sweet_early.c, osfmk/arm64/start.s): LK's splash buffer,
+ * 1080x2400 at 0x9c000000, 4320 bytes per line, scanned out from its origin.
+ */
+#define BOARD_FB_BASE             0x9c000000
+#define BOARD_FB_WIDTH            1080
+#define BOARD_FB_HEIGHT           2400
+#define BOARD_FB_STRIDE           4320
+#define BOARD_FB_XOFF             0
+#define BOARD_FB_YTOP             0
+
+/* The 32MB block the framebuffer lives in: start.s maps it whole, Normal-NC. */
+#define BOARD_EARLY_FB_BLOCK      0x9c000000
+#define BOARD_EARLY_FB_OFFSET     (BOARD_FB_BASE - BOARD_EARLY_FB_BLOCK)
+
+/* Stage-0 band drawn by start_first_cpu before the MMU comes on. */
+#define BOARD_FB_STAGE0_ADDR      (BOARD_FB_BASE + 2368 * BOARD_FB_STRIDE)
+/* First row the bootstrap text console owns. */
+#define BOARD_FB_EARLY_YTOP       BOARD_FB_YTOP
+
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
 #define GICR_PE_SIZE              0x20000 // Size of each redistributor region
diff --git a/pexpert/pexpert/arm64/LANCELOT.h b/pexpert/pexpert/arm64/LANCELOT.h
--- a/pexpert/pexpert/arm64/LANCELOT.h
+++ b/pexpert/pexpert/arm64/LANCELOT.h
@@ -45,6 +45,32 @@
 /* Device-tree node the framebuffer console binds (pexpert/arm/pe_serial.c). */
 #define BOARD_FBCON_NODE          "lancelot-fbcon"
 
+/*
+ * Boot framebuffer, from the DTBO /chosen atag,videolfb and measured on the
+ * phone (docs/lancelot-hardware.md section 6): 1080x2340, 4320 bytes per line,
+ * base 0x7e605000. The panel starts scanning 256 px into each line and the top
+ * 520 rows belong to LK's own splash layer, so the console may only use the
+ * area below them.
+ */
+#define BOARD_FB_BASE             0x7e605000
+#define BOARD_FB_WIDTH            1080
+#define BOARD_FB_HEIGHT           2340
+#define BOARD_FB_STRIDE           4320
+#define BOARD_FB_XOFF             256
+#define BOARD_FB_YTOP             520
+
+/* The 32MB block the framebuffer lives in: start.s maps it whole, Normal-NC. */
+#define BOARD_EARLY_FB_BLOCK      0x7e400000
+#define BOARD_EARLY_FB_OFFSET     (BOARD_FB_BASE - BOARD_EARLY_FB_BLOCK)
+
+/*
+ * Stage-0 band drawn by start_first_cpu before the MMU comes on: the first
+ * visible row, 64x32 px, which the loader leaves free for exactly this.
+ */
+#define BOARD_FB_STAGE0_ADDR      (BOARD_FB_BASE + BOARD_FB_YTOP * BOARD_FB_STRIDE + BOARD_FB_XOFF * 4)
+/* First row the bootstrap text console owns: just under the stage-0 band. */
+#define BOARD_FB_EARLY_YTOP       (BOARD_FB_YTOP + 56)
+
 /* 2x Cortex-A75 + 6x Cortex-A55. cpus=1 by default, see machine_routines.c. */
 #define LANCELOT_SMP_MAX_CPUS     8
 #define BOARD_SMP_MAX_CPUS        LANCELOT_SMP_MAX_CPUS
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -513,9 +513,11 @@
 	mov		x20, x0
 	mov		x21, #0
 
-#if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+#if defined(SWEET) || defined(LANCELOT)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. It is the
+	 * first evidence that control ever reached the kernel, so each board puts
+	 * it somewhere the panel is known to show (BOARD_FB_STAGE0_ADDR). */
+	MOV64	x0, BOARD_FB_STAGE0_ADDR
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -678,15 +680,15 @@
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(LANCELOT)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Boot framebuffer: one 32MB Normal-NC block in the EXISTING V=P L2
+	 * table. Both framebuffer and RAM use L1 index 0; another call to
+	 * create_bootstrap_mapping would replace the RAM L2 table. These boards
+	 * use 16K pages and all bring-up RAM is below 4GB, so the first V=P L2
+	 * page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, BOARD_EARLY_FB_BLOCK
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
